# 构建产物（可重建）
/build/
/godot/.godot/
/godot/android/.gradle/
/godot/android/captures/
/godot/android/local.properties
/godot/android/.cxx/

# 临时凭据工作目录（绝不入库）
.tmp_git/

# 发布用 APK 本体不入库（走 GitHub Release 分发）
/dist/*.apk
/dist/*.idsig

# 系统与编辑器
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# ---- Android 自定义 Gradle 构建模板（godot/android/）----
# ★ 模板骨架（godot/android/build/build.gradle 等）必须入库，
#   否则 Godot 自定义 Gradle 构建会因缺 build.gradle 而失败。
#   所以这里逐条排除子路径，绝不能用 /godot/android/build/ 整目录规则。
godot/android/libs/
godot/android/.gradle/
godot/android/captures/
godot/android/local.properties
godot/android/.cxx/
godot/android/build/build/
godot/android/build/libs/
godot/android/build/src/release/
godot/android/build/.gdignore
godot/android/build/.gradle/
godot/android/build/captures/
godot/android/build/local.properties
godot/android/build/.cxx/
godot/android/build/src/main/assets/
godot/android/build/src/debug/
godot/android/build/src/instrumented/assets/
godot/android/build/assetPackInstallTime/build/
